{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "editor.formatOnSave": true,
  "files.exclude": {
    "**/.git": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/.langgraph_api": true,
    "**/.data": true,
    "**/.obsidian": true,
    "**/.grimp_cache": true,
    "**/.import_linter_cache": true,
    "**/LICENSE": true,
    "**/uv.lock": true,
  },
  "cSpell.words": [
    "agentevals",
    "checkpointer",
    "docstrings",
    "Evals",
    "graphrag",
    "HITL",
    "worldcup"
  ]
}
